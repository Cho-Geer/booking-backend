NODE_ENV=development
PORT=3001
API_PREFIX=/v1

DATABASE_URL=postgresql://postgres:5382@127.0.0.1:5432/booking_system

# Redis ホストは 127.0.0.1 を指定する。
# 'localhost' は環境によって IPv6(::1) に解決され、別の Redis に接続してしまうことがある。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

FRONTEND_URLS=http://127.0.0.1:3000,http://localhost:3000

JWT_SECRET=change-me
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=30d

CSRF_ENABLED=true

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com

# Salesforce 连携(A3/IF-02)静态 Bearer Token・与 SF 侧 External Credential guardSecret 同一值・实际值绝不提交
INTEGRATION_TOKEN=

# Salesforce 投影送信（IF-01・A2 OAuth JWT Bearer・P0-3 B-4）・实际值绝不提交
SF_LOGIN_URL=https://login.salesforce.com
SF_REST_BASE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=certs/booking-integration.key
SF_PROJECTION_ENABLED=true

# —— seed 静态操作员映射（可选，默认关闭）——
# SEED_STATIC_OPERATOR_MAPPING=true 时，prisma db seed 会为第一管理员写入 SF 映射
# 仅开发联调使用；SEED_SF_USER_ID 必须是真实 SF 用户 ID，禁止填占位值
# SEED_STATIC_OPERATOR_MAPPING=
# SEED_SF_USER_ID=005XXXXXXXXXXXXXXX
