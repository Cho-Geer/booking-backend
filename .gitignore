/node_modules
/dist
/coverage
/test-results

/.env
# 文档管理策略：默认忽略docs目录，明确列出需要版本管理的文档
/docs/*
# 核心项目文档（必须纳入版本管理）
# API契约（行尾注释会使白名单失效，注释必须独立成行）
!/docs/api-contract.md
# API契约日译版（作品集用）
!/docs/api-contract.ja.md
# 手动重试手顺书（B-7）运维参考用
!/docs/manual-retry-procedure.md
# 文档导航 / Redis / シナリオ深掘り / 時序図（ルート README.md 参照）
!/docs/redis-usage-and-schema.md
!/docs/scenario-deep-dive.md
!/docs/sequence-diagrams/
!/docs/sequence-diagrams/*
# 内部文档（不应提交）
/docs/private/                  # 内部决策、计划和临时文档
/logs/*
/.qoder
/.sfdx
/.trae
/.trae-aicc
/.clinerules
/.env.production
/.env.development
/.env.development.backup
/.env.test
/.env.instance*
# 个人本地配置文件（不应提交）
/.env.local
/.env.*.local
# 注意：.env.development.example 是模板文件，应该提交到版本控制
/uploads

# 操作系统文件（不应提交）
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 临时文件（不应提交）
*.log
*.tmp
*.temp
*.pid
*.seed
*.pid.lock
# 编辑器临时文件
*~
*.swp
*.swo

# IDE 配置文件（不应提交，但部分配置可共享）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# JWT Bearer 证书私钥（Booking→SF integration・绝不入库）
certs/

# Mimosa 插件 hook 状态目录（工具产物，不入库）
.mimosa/
