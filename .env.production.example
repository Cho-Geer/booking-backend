NODE_ENV=production
PORT=3001
API_PREFIX=/v1

DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/booking_system

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

FRONTEND_URLS=https://your-frontend-domain.example

JWT_SECRET=change-me
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=30d

CSRF_ENABLED=true

UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=/uploads

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@example.com

# Salesforce 连携(A3/IF-02)静态 Bearer Token・与 SF 侧 External Credential guardSecret 同一值・实际值绝不提交
INTEGRATION_TOKEN=

# Salesforce 投影送信（IF-01・A2 OAuth JWT Bearer・P0-3 B-4）・实际值绝不提交
SF_LOGIN_URL=https://login.salesforce.com
SF_REST_BASE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=certs/sf-integration-key.pem
SF_PROJECTION_ENABLED=true
