# 测试环境配置
# 测试环境使用的环境变量

# 应用配置
NODE_ENV=test
PORT=3001
API_PREFIX=/v1

# CORS 配置
FRONTEND_URLS=http://127.0.0.1:3000,http://localhost:3000

# CSRF 配置
CSRF_ENABLED=true

# 数据库配置
DATABASE_URL=postgresql://test:test@127.0.0.1:5432/booking_test

# JWT配置
JWT_SECRET=test-jwt-secret-key-for-testing-environment-only
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-environment-only
JWT_REFRESH_EXPIRES_IN=7d

# Redis配置（测试环境可选）
# 'localhost' は環境によって IPv6(::1) に解決されるため 127.0.0.1 を指定する。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# 邮件配置（测试环境使用模拟服务）
MAIL_HOST=smtp.test.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=test-password
MAIL_FROM=noreply@test.com

# 文件上传配置
UPLOAD_DIR=./uploads/test
UPLOAD_BASE_URL=/uploads

# Salesforce 连携(A3/IF-02)静态 Bearer Token・与 SF 侧 External Credential guardSecret 同一值・实际值绝不提交
INTEGRATION_TOKEN=

# Salesforce 投影送信（IF-01・A2 OAuth JWT Bearer・P0-3 B-4）・实际值绝不提交
SF_LOGIN_URL=https://login.salesforce.com
SF_REST_BASE_URL=https://your-org.my.salesforce.com
SF_CLIENT_ID=
SF_USERNAME=
SF_PRIVATE_KEY_PATH=certs/booking-integration.key
SF_PROJECTION_ENABLED=true
